# Local development (docker compose up -d postgres)
DATABASE_URL=postgres://gum:gum@localhost:54329/gum
GUM_PROFILE=local
GUM_WEBHOOK__SECRET=dev-webhook-secret

# Production (Railway): set per enabled chain
# GUM_CHAINS__MONAD__HTTP_URL=https://<name>.monad-mainnet.quiknode.pro/<token>/
# GUM_CHAINS__MONAD__WS_URL=wss://<name>.monad-mainnet.quiknode.pro/<token>/
# GUM_CHAINS__ARBITRUM__HTTP_URL=...   GUM_CHAINS__ARBITRUM__WS_URL=...
# GUM_CHAINS__BASE__HTTP_URL=...       GUM_CHAINS__BASE__WS_URL=...
# GUM_QUICKNODE__API_KEY=<admin api key, optional: exports credits remaining>
